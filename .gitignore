!artifacts/runs/*/
artifacts/runs/*/*
!artifacts/runs/*/log.csv
!artifacts/runs/*/config.json
!artifacts/flies/
artifacts/flies/*
!artifacts/flies/*.json
!artifacts/flies/*.npz
!artifacts/flies/*.pt
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
